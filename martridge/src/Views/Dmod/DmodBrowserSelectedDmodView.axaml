<UserControl x:Class="Martridge.Views.Dmod.DmodBrowserSelectedDmodView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

             xmlns:dloc="using:Martridge.ViewModels.Localization"
             xmlns:vm="using:Martridge.ViewModels.Dmod"
             xmlns:valueConverters="clr-namespace:Martridge.ViewModels.ValueConverters"

             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Name="TheDmodBrowserSelectedDmodView">

    <Design.DataContext>
        <vm:DmodBrowserViewModel />
    </Design.DataContext>
    <UserControl.Styles>
        <StyleInclude Source="avares://martridge/AppStyles.axaml" />
    </UserControl.Styles>
    <UserControl.Resources>
        <x:String x:Key="DataNotAvailable">N/A</x:String>
        <GridLength x:Key="LeftColumnWidth">160</GridLength>
        <valueConverters:DoubleCompareToBoolConverter x:Key="DoubleGreaterThanToBoolConverter" Mode="GreaterOrEqualTo" />
        <valueConverters:DoubleCompareToBoolConverter x:Key="DoubleLessThanToBoolConverter" Mode="LessThan" />
        <x:Double x:Key="ImageToggleWidthThreshold">800</x:Double>
        <x:Double x:Key="ImageWidth">300</x:Double>
    </UserControl.Resources>

    <Grid>

        <StackPanel
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            IsVisible="{Binding SelectedDmodDefinition,
                      Converter={x:Static ObjectConverters.IsNull}}">

            <Label Classes="HeadingTitle"
                   HorizontalAlignment="Center"
                   Content="{dloc:Localize DmodBrowser/NoDmodSelectedTitle}" />

            <Label Classes="Heading3IWrapping"
                   HorizontalAlignment="Center"
                   MaxWidth="400"
                   Content="{dloc:Localize DmodBrowser/NoDmodSelectedBody}" />
        </StackPanel>

        <ScrollViewer>
            <Grid RowDefinitions="Auto,*"
                  IsVisible="{Binding SelectedDmodDefinition,
                      Converter={x:Static ObjectConverters.IsNotNull}}">

                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Vertical">

                        <Label Classes="Heading1B"
                               Content="{Binding SelectedDmodDefinition.Name, 
                            FallbackValue={StaticResource DataNotAvailable},
                            TargetNullValue={StaticResource DataNotAvailable} }" />
                        <Label Classes="Heading3IWrapping"
                               Content="{Binding SelectedDmodDefinition.DmodDirectory, 
                                    FallbackValue={StaticResource DataNotAvailable},
                                    TargetNullValue={StaticResource DataNotAvailable} }"
                               ToolTip.Tip="{Binding SelectedDmodDefinition.DmodDirectory, 
                                    FallbackValue={StaticResource DataNotAvailable},
                                    TargetNullValue={StaticResource DataNotAvailable} }" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource LeftColumnWidth}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Row="0" Grid.Column="0"
                                    Content="{dloc:Localize DmodBrowser/LaunchDmod}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Width="NaN"
                                    Height="NaN"
                                    Command="{Binding CmdLaunchDmod}" />
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding GameExePaths}"
                                      SelectedItem="{Binding ActiveGameExePath, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="vm:DmodLauncherSelectionViewModel">
                                        <Label Classes="Heading2B" Content="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <Grid RowDefinitions="Auto,Auto">
                            <Label Grid.Row="1" Classes="Heading3IWrapping"
                                   Content="{Binding ActiveGameExePath.Path, 
                                        FallbackValue={StaticResource DataNotAvailable},
                                        TargetNullValue={StaticResource DataNotAvailable} }"
                                   ToolTip.Tip="{Binding ActiveGameExePath.Path, 
                                        FallbackValue={StaticResource DataNotAvailable},
                                        TargetNullValue={StaticResource DataNotAvailable} }" />
                        </Grid>


                        <Grid IsVisible="{Binding ShowDmodDevFeatures}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource LeftColumnWidth}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Row="0" Grid.Column="0"
                                    Content="{dloc:Localize DmodBrowser/EditDmod}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Width="NaN" Height="NaN"
                                    Command="{Binding CmdLaunchDmod}"
                                    CommandParameter="{Binding LaunchEditorParameter}" />
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding EditorExePaths}"
                                      SelectedItem="{Binding ActiveEditorExePath, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="vm:DmodLauncherSelectionViewModel">
                                        <Label Classes="Heading2B" Content="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <Grid RowDefinitions="Auto,Auto"
                              IsVisible="{Binding ShowDmodDevFeatures}">
                            <Label Grid.Row="1" Classes="Heading3IWrapping"
                                   Content="{Binding ActiveEditorExePath.Path, 
                                      FallbackValue={StaticResource DataNotAvailable},
                                      TargetNullValue={StaticResource DataNotAvailable} }"
                                   ToolTip.Tip="{Binding ActiveEditorExePath.Path, 
                                      FallbackValue={StaticResource DataNotAvailable},
                                      TargetNullValue={StaticResource DataNotAvailable} }" />
                        </Grid>

                        <Grid IsVisible="{Binding ShowLaunchRefDirPathInMainWindow}">
                            <Grid IsVisible="{Binding LaunchUseRefDir}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LeftColumnWidth}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Row="0" Grid.Column="0"
                                        Classes="Primary"
                                        Width="NaN"
                                        Height="NaN"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Content="{dloc:Localize DmodBrowser/LaunchRefDirPath/Browse}"
                                        Command="{Binding CmdLaunchRefDirBrowse}" />
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         HorizontalAlignment="Stretch"
                                         Text="{Binding  LaunchRefDirPath}">
                                </TextBox>
                            </Grid>
                        </Grid>

                        <Grid IsVisible="{Binding ShowLaunchCustomArgsInMainWindow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource LeftColumnWidth}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="{dloc:Localize DmodBrowser/LaunchCustomUserArguments}" Classes="Heading2B" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     HorizontalAlignment="Stretch"
                                     Text="{Binding  LaunchCustomUserArguments}">
                            </TextBox>
                        </Grid>

                        <Grid IsVisible="{Binding ShowFreeDinkLocalizations}" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource LeftColumnWidth}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Label Grid.Row="0" Grid.Column="0"
                                   Content="{dloc:Localize DmodBrowser/FreeDinkLocalization}"
                                   Classes="Heading2B"/>
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      HorizontalAlignment="Stretch"
                                      SelectedItem="{Binding SelectedLocalization}"
                                      ItemsSource="{Binding  SelectedDmodDefinition.Localizations }">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="vm:DmodLocalizationDefinition">
                                        <Grid>
                                            <Label Content="{Binding Header}" />
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </StackPanel>

                    <Image Grid.Column="1" Source="{Binding SelectedDmodDefinition.Thumbnail}"
                           Margin="2"
                           Width="{StaticResource ImageWidth}" Height="NaN"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Stretch="Uniform"
                           IsVisible="{Binding #TheDmodBrowserSelectedDmodView.Bounds.Width,
                                    Converter={StaticResource DoubleGreaterThanToBoolConverter},
                                    ConverterParameter={StaticResource ImageToggleWidthThreshold} }" />
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource LeftColumnWidth}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Label Classes="Heading2B"
                               Content="{dloc:Localize DmodBrowser/LaunchArguments}" />

                        <CheckBox Content="{dloc:Localize DmodBrowser/LaunchSkip}"
                                  ToolTip.Tip="{dloc:Localize DmodBrowser/LaunchSkip/Tooltip}"
                                  IsChecked="{Binding LaunchSkip}" />
                        <CheckBox Content="{dloc:Localize DmodBrowser/LaunchUseRefDir}"
                                  ToolTip.Tip="{dloc:Localize DmodBrowser/LaunchUseRefDir/Tooltip}"
                                  IsChecked="{Binding LaunchUseRefDir}" />
                        <CheckBox Content="{dloc:Localize DmodBrowser/LaunchTrueColor}"
                                  ToolTip.Tip="{dloc:Localize DmodBrowser/LaunchTrueColor/Tooltip}"
                                  IsChecked="{Binding LaunchTrueColor}" />
                        <CheckBox Content="{dloc:Localize DmodBrowser/LaunchWindowed}"
                                  ToolTip.Tip="{dloc:Localize DmodBrowser/LaunchWindowed/Tooltip}"
                                  IsChecked="{Binding LaunchWindowed}" />
                        <CheckBox Content="{dloc:Localize DmodBrowser/LaunchSound}"
                                  ToolTip.Tip="{dloc:Localize DmodBrowser/LaunchSound/Tooltip}"
                                  IsChecked="{Binding LaunchSound}" />
                        <CheckBox Content="{dloc:Localize DmodBrowser/LaunchJoystick}"
                                  ToolTip.Tip="{dloc:Localize DmodBrowser/LaunchJoystick/Tooltip}"
                                  IsChecked="{Binding LaunchJoystick}" />
                        <CheckBox Content="{dloc:Localize DmodBrowser/LaunchDebug}"
                                  ToolTip.Tip="{dloc:Localize DmodBrowser/LaunchDebug/Tooltip}"
                                  IsChecked="{Binding LaunchDebug}" />
                        <CheckBox Content="{dloc:Localize DmodBrowser/LaunchV107Mode}"
                                  ToolTip.Tip="{dloc:Localize DmodBrowser/LaunchV107Mode/Tooltip}"
                                  IsChecked="{Binding LaunchV107Mode}" />
                        <CheckBox Content="{dloc:Localize DmodBrowser/LaunchUsePathRelativeToGame}"
                                  ToolTip.Tip="{dloc:Localize DmodBrowser/LaunchUsePathRelativeToGame/Tooltip}"
                                  IsChecked="{Binding LaunchUsePathRelativeToGame}" />
                        <CheckBox Content="{dloc:Localize DmodBrowser/LaunchUsePathQuotationMarks}"
                                  ToolTip.Tip="{dloc:Localize DmodBrowser/LaunchUsePathQuotationMarks/Tooltip}"
                                  IsChecked="{Binding LaunchUsePathQuotationMarks}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Vertical">
                        <Image Source="{Binding SelectedDmodDefinition.Thumbnail}"
                               Margin="2"
                               Width="{StaticResource ImageWidth}" Height="NaN"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Stretch="Uniform"
                               IsVisible="{Binding #TheDmodBrowserSelectedDmodView.Bounds.Width,
                                    Converter={StaticResource DoubleLessThanToBoolConverter},
                                    ConverterParameter={StaticResource ImageToggleWidthThreshold} }" />

                        <TextBox
                            Text="{Binding SelectedDmodDefinition.Description, 
                             FallbackValue={StaticResource DataNotAvailable},
                             TargetNullValue={StaticResource DataNotAvailable}  }"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            TextWrapping="Wrap"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            IsReadOnly="True" />
                    </StackPanel>

                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>