<UserControl x:Class="Martridge.Views.DinkInstaller.DinkInstallerView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             
             xmlns:dinkInstaller="clr-namespace:Martridge.ViewModels.DinkInstaller"
             xmlns:dinkInstaller1="clr-namespace:Martridge.Views.DinkInstaller"

             mc:Ignorable="d" 
             d:DesignWidth="800" 
             d:DesignHeight="800"
             
             Name="DinkInstallerUserControl">

    <Design.DataContext>
        <dinkInstaller:DinkInstallerViewModel/>
    </Design.DataContext>
    <UserControl.Styles>
        <StyleInclude Source="avares://martridge/AppStyles.axaml" />
    </UserControl.Styles>

    <Grid Margin="8">
        <Grid IsVisible="{Binding Path=DinkInstallerNotSupported}">
            <dinkInstaller1:DinkInstallerNotSupportedView
                DataContext="{Binding DataContext, ElementName=DinkInstallerUserControl}"/>
        </Grid>
        
        <Grid IsVisible="{Binding Path=!DinkInstallerNotSupported}">
            <Grid RowDefinitions="*, Auto" IsVisible="{Binding Path=!IsInstallerStarted}">
                <dinkInstaller1:DinkInstallerPrepareView
                    Grid.Row="0"
                    DataContext="{Binding DataContext, ElementName=DinkInstallerUserControl}"/>
            </Grid>
                
            <Grid RowDefinitions="*, Auto" IsVisible="{Binding Path=IsInstallerStarted}">
                <dinkInstaller1:InstallerProgressView 
                    Grid.Row="0"
                    DataContext="{Binding DataContext, ElementName=DinkInstallerUserControl}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>