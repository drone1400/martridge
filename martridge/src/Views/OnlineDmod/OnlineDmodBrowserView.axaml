<UserControl x:Class="Martridge.Views.OnlineDmod.OnlineDmodBrowserView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

             xmlns:dloc="using:Martridge.ViewModels.Localization"
             xmlns:vm="using:Martridge.ViewModels.Dmod"
             xmlns:vw="using:Martridge.Views.Dmod"
             xmlns:valueConverters="clr-namespace:Martridge.ViewModels.ValueConverters"
             xmlns:onlineDmod="clr-namespace:Martridge.ViewModels.OnlineDmod"
             xmlns:onlineDmod1="clr-namespace:Martridge.Views.OnlineDmod"

             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450">

    <Design.DataContext>
        <onlineDmod:OnlineDmodBrowserViewModel />
    </Design.DataContext>
    <UserControl.Styles>
        <StyleInclude Source="avares://martridge/AppStyles.axaml" />
    </UserControl.Styles>
    <UserControl.Resources>
        <valueConverters:IsNotNullCheckBoolConverter x:Key="ConverterIsNotNullCheck" />
    </UserControl.Resources>

    <Grid>
        <Border Classes="MartridgeCard">
            <vw:MagicSplitPresenterView
                Name="MagicSplit"
                OnePageSwitchThreshold="950"
                LeftPanelMinWidth="560"
                RightPanelMinWidth="360"
                IsOnePageShowingRightContent="{Binding SelectedDmodDefinition, 
                Converter={StaticResource ConverterIsNotNullCheck}}"
                LeftPanelolumnLengthInitialized="{Binding OnlineDmodBrowserLeftPanelColumnWidthSet, Mode=TwoWay}"
                RightPanelolumnLengthInitialized="{Binding OnlineDmodBrowserRightPanelColumnWidthSet, Mode=TwoWay}"
                LeftPanelLastSetColumnLength="{Binding OnlineDmodBrowserLeftPanelColumnWidth, Mode=TwoWay}"
                RightPanelLastSetColumnLength="{Binding OnlineDmodBrowserRightPanelColumnWidth, Mode=TwoWay}"
                IsEnabled="{Binding !DmodCrawlerIsBusy}">

                <vw:MagicSplitPresenterView.LeftPanelContent>
                    <onlineDmod1:OnlineDmodBrowserDmodListView DataContext="{Binding }" />
                </vw:MagicSplitPresenterView.LeftPanelContent>

                <vw:MagicSplitPresenterView.RightPanelContent>
                    <Grid RowDefinitions="Auto, *">
                        <Button Grid.Row="0"
                                IsVisible="{Binding IsViewOnePageMode, ElementName=MagicSplit}"
                                HorizontalAlignment="Stretch"
                                Width="NaN"
                                Command="{Binding CmdClearSelectedDmod}"
                                Content="{dloc:Localize DmodBrowser/BackToList}" />


                        <onlineDmod1:OnlineDmodBrowserSelectedDmodView
                            Grid.Row="1"
                            DataContext="{Binding }" />
                    </Grid>
                </vw:MagicSplitPresenterView.RightPanelContent>

            </vw:MagicSplitPresenterView>
        </Border>
        
        <!-- copied this layout from the DinkyAlert xaml lul -->
        <Grid ColumnDefinitions="*,4*,*" RowDefinitions="*,Auto,*"
              IsVisible="{Binding DmodCrawlerIsBusy}"
              x:Name="TheGrid">
            <Grid
                Grid.Row="0" Grid.RowSpan="3"
                Grid.Column="0" Grid.ColumnSpan="3"
                Background="{DynamicResource ThemeBackgroundBrush}" Opacity="0.5" />

            <!-- this may seem rather odd, but if we don't do this max width binding here, the Label below that binds to the message
                    will stretch endlessly instead of wrapping -->
            <Grid
                Grid.Row="1" Grid.Column="1"
                MaxWidth="{Binding Bounds.Width, ElementName=TheGrid}">

                <Border Classes="MartridgeCard"
                        Margin="40,10">
                    <Grid
                        RowDefinitions="Auto, Auto, Auto, Auto"
                        Margin="5,10">

                        <Label
                            Grid.Row="0" Grid.Column="0"
                            Classes="HeadingTitle"
                            HorizontalAlignment="Center"
                            Content="{dloc:Localize OnlineDmodBrowser/DownloadingData}" />
                        <Label
                            Grid.Row="1" Grid.Column="0"
                            Classes="Heading2IWrapping"
                            HorizontalAlignment="Center"
                            Content="{Binding DmodCrawlerCurrentUrl}" />

                        <ProgressBar
                            Grid.Row="2"
                            IsIndeterminate="True" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>