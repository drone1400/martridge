<UserControl x:Class="Martridge.Views.Dmod.NoDinkyView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             
             xmlns:dmodVm="clr-namespace:Martridge.ViewModels.Dmod"
             xmlns:dloc="clr-namespace:Martridge.ViewModels.Localization"
             
             mc:Ignorable="d" 
             d:DesignWidth="800" 
             d:DesignHeight="450">
    
    <Design.DataContext>
        <dmodVm:NoDinkyViewModel />
    </Design.DataContext>
    <UserControl.Styles>
        <StyleInclude Source="avares://martridge/AppStyles.axaml" />
    </UserControl.Styles>
    
    <Grid ColumnDefinitions="*,Auto,*">
        <Image Grid.Column="0" 
               Source="{Binding AnimatedDuckWizardRight.Frame}"
               Width="99"
               VerticalAlignment="Center"/>
      
        <Image Grid.Column="2" 
               Source="{Binding AnimatedDuckWizardLeft.Frame}"
               Width="99"
               VerticalAlignment="Center" />
      
        <Grid Grid.Column="1"  
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              RowDefinitions="Auto,Auto,Auto">

            <Label Grid.Row="0" Classes="HeadingTitle"
                   HorizontalAlignment="Center"
                   Content="{dloc:Localize MainWindow/NoDmods_Title}"/>

            <Label Grid.Row="1" Classes="Heading2IWrapping"
                   HorizontalAlignment="Center"
                   MaxWidth="360"
                   Content="{dloc:Localize MainWindow/NoDmods_Body}"/>
        
            <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto" Margin="10" HorizontalAlignment="Center">
                <Button Grid.Column="0"
                        Content="{dloc:Localize MainWindow/MenuDinkInstaller}"
                        Command="{Binding CmdShowDinkInstallerPage}"/>
                <Button Grid.Column="1"
                        Content="{dloc:Localize MainWindow/MenuSettings}"
                        Command="{Binding CmdShowConfigurationPage}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
