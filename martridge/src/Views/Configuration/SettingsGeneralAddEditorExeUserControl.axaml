<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dloc="using:Martridge.ViewModels.Localization"
             xmlns:vm="using:Martridge.ViewModels.Configuration"

             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"

             x:Class="Martridge.Views.Configuration.SettingsGeneralAddEditorExeUserControl"

             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <Design.DataContext>
        <vm:SettingsGeneralViewModel />
    </Design.DataContext>
    <UserControl.Styles>
        <StyleInclude Source="avares://martridge/AppStyles.axaml" />
    </UserControl.Styles>


    <Border BorderThickness="1"
            BorderBrush="{DynamicResource ThemeBorderHighBrush}"
            Margin="6,3">
        <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,*">
            <TextBox Grid.Row="0" Grid.Column="0"
                     UseFloatingWatermark="True"
                     Watermark="{dloc:Localize SettingsGeneral/EditorExePaths}"
                     Text="{Binding EditorExeAddNewManualValue}" />
            <Button Grid.Row="0" Grid.Column="1"
                    Content="{dloc:Localize SettingsGeneral/EditorExePaths_AddManual}"
                    Classes="Primary"
                    Command="{Binding CmdEditorExeAddNewManual}" />
            <Button Grid.Row="0" Grid.Column="2"
                    Content="{dloc:Localize SettingsGeneral/EditorExePaths_AddBrowse}"
                    Classes="Primary"
                    Command="{Binding CmdEditorExeAddNew}" />
            <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" ColumnDefinitions="Auto,*">
                <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*">
                    <Button Grid.Row="0"
                            Command="{Binding CmdEditorExeMoveSelectedUp}"
                            Classes="ListBoxButtonLeftBlue"
                            Background="{DynamicResource ThemeAccentBrush}">
                        <Path Classes="ListBoxIconArrow" />
                    </Button>
                    <Button Grid.Row="1"
                            Command="{Binding CmdEditorExeRemoveSelected}"
                            Classes="ListBoxButtonLeft">
                        <Path Classes="ListBoxIconTrashCan" />
                    </Button>
                    <Button Grid.Row="2"
                            Command="{Binding CmdEditorExeMoveSelectedDown}"
                            Classes="ListBoxButtonLeftBlue">
                        <Path Classes="ListBoxIconArrow">
                            <Path.RenderTransform>
                                <RotateTransform Angle="180" />
                            </Path.RenderTransform>
                        </Path>
                    </Button>
                </Grid>
                <ListBox Grid.Column="1"
                         ItemsSource="{Binding EditorExePaths}"
                         SelectedIndex="{Binding SelectedEditorExePathIndex}"
                         VerticalAlignment="Top">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,*">
                                <Button Grid.Column="0"
                                        Command="{Binding $parent[UserControl].DataContext.CmdExeExtensionEdit}"
                                        CommandParameter="{Binding }"
                                        Classes="ListBoxButton">
                                    <Path Classes="ListBoxIconGear" />
                                </Button>
                                <TextBlock Grid.Column="1" Text="{Binding}"></TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Border>
</UserControl>