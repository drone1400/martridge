<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dloc="using:Martridge.ViewModels.Localization"
        xmlns:vm="using:Martridge.ViewModels"
        xmlns:martridge="clr-namespace:Martridge"
        xmlns:controls="clr-namespace:Martridge.Controls"
        xmlns:valueConverters="clr-namespace:Martridge.ViewModels.ValueConverters"

        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"

        MinWidth="780"
        MinHeight="580"

        x:Class="Martridge.Views.MainWindow"

        Icon="/Assets/martridge_new.ico"
        Title="{dloc:Localize MainWindow/Title}"
        Background="{DynamicResource ThemeBackgroundColor}"
        Name="TheMainWindow"
        
        KeyDown="InputElement_OnKeyDown"
        XYFocus.NavigationModes="Enabled">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>
    <Window.Styles>
        <StyleInclude Source="avares://martridge/AppStyles.axaml" />
    </Window.Styles>
    <Window.Resources>
        <valueConverters:TypeCompareToBoolConverter x:Key="TypeCompareToBoolConverter"/>
    </Window.Resources>

    <Border
        Margin="0"
        Padding="0"
        Background="Transparent"
        BorderBrush="Transparent"
        BorderThickness="0"
        CornerRadius="0"
        DragDrop.AllowDrop="True">
        <Grid RowDefinitions="Auto,*" ColumnDefinitions="Auto,*">
            <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="*,Auto">
                <Grid.Styles>
                    <Style Selector="controls|SelectableButton">
                        <Setter Property="Width" Value="180"/>
                    </Style>
                </Grid.Styles>

                <WrapPanel Grid.Row="0"
                           Background="{DynamicResource ThemeAccentBrush2}"
                           Orientation="Vertical">

                    <controls:SelectableButton
                        Content="{dloc:Localize MainWindow/PageSelect/DmodBrwoser}" 
                        Command="{Binding CmdShowPageMyDmods}" 
                        IsSelected="{Binding CurrentViewModel,
                            Converter={StaticResource TypeCompareToBoolConverter},
                            ConverterParameter={}DmodBrowserViewModel,
                            Mode=OneWay}" />
                    
                    <controls:SelectableButton
                        Content="{dloc:Localize MainWindow/PageSelect/OnlineDmodBrwoser}" 
                        Command="{Binding CmdShowPageOnlineDmods}" 
                        IsVisible="{Binding EnableOnlineFeatures}"
                        IsSelected="{Binding CurrentViewModel,
                            Converter={StaticResource TypeCompareToBoolConverter},
                            ConverterParameter={}OnlineDmodBrowserViewModel,
                            Mode=OneWay}" />

                    <controls:SelectableButton
                        Content="{dloc:Localize MainWindow/PageSelect/DmodInstaller}"
                        Command="{Binding CmdShowPageDmodInstallerAndBrowse}" 
                        IsSelected="{Binding CurrentViewModel,
                            Converter={StaticResource TypeCompareToBoolConverter},
                            ConverterParameter={}DmodInstallerViewModel,
                            Mode=OneWay}" />

                    <controls:SelectableButton
                        Content="{dloc:Localize MainWindow/PageSelect/DmodPacker}"
                        Command="{Binding CmdShowPageDmodPackerAndBrowse}"
                        IsSelected="{Binding CurrentViewModel,
                            Converter={StaticResource TypeCompareToBoolConverter},
                            ConverterParameter={}DmodPackerViewModel,
                            Mode=OneWay}"
                        IsVisible="{Binding EnableDmodDeveloperFeatures}"
                        IsEnabled="{Binding EnableDmodDeveloperFeatures}" />

                    <controls:SelectableButton
                        Content="{dloc:Localize MainWindow/PageSelect/DinkInstaller}"
                        Command="{Binding CmdShowPageDinkInstaller}"
                        IsSelected="{Binding CurrentViewModel,
                            Converter={StaticResource TypeCompareToBoolConverter},
                            ConverterParameter={}DinkInstallerViewModel,
                            Mode=OneWay}"
                        IsVisible="{Binding EnableDinkInstallerMenu}"
                        IsEnabled="{Binding EnableDinkInstallerMenu}" />

                </WrapPanel>

                <WrapPanel Grid.Row="1"
                           Background="{DynamicResource ThemeAccentBrush2}"
                           Orientation="Vertical">
                    <controls:SelectableButton
                        Content="{dloc:Localize MainWindow/PageSelect/Theme}"
                        IsSelected="{Binding CurrentViewModel,
                            Converter={StaticResource TypeCompareToBoolConverter},
                            ConverterParameter={}SettingsThemeViewModel,
                            Mode=OneWay}"
                        Command="{Binding CmdShowPageSettingsTheme}" />
                    
                    <controls:SelectableButton
                        Content="{dloc:Localize MainWindow/PageSelect/Settings}"
                        IsSelected="{Binding CurrentViewModel,
                            Converter={StaticResource TypeCompareToBoolConverter},
                            ConverterParameter={}SettingsGeneralViewModel,
                            Mode=OneWay}"
                        Command="{Binding CmdShowPageSettings}" />

                    <controls:SelectableButton
                        Content="{dloc:Localize MainWindow/PageSelect/About}"
                        IsSelected="{Binding CurrentViewModel,
                            Converter={StaticResource TypeCompareToBoolConverter},
                            ConverterParameter={}AboutViewModel,
                            Mode=OneWay}"
                        Command="{Binding CmdShowPageAbout}" />
                </WrapPanel>

            </Grid>

            <Grid Grid.Row="1" Grid.Column="1">
                <ContentControl Content="{Binding CurrentViewModel}">
                    <ContentControl.DataTemplates>
                        <martridge:MainViewLocator />
                    </ContentControl.DataTemplates>
                </ContentControl>
            </Grid>
        </Grid>
    </Border>
</Window>