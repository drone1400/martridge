<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dloc="using:Martridge.ViewModels.Localization"
             xmlns:configuration="clr-namespace:Martridge.ViewModels.Configuration"
             xmlns:configuration1="clr-namespace:Martridge.Views.Configuration"
             xmlns:configuration2="clr-namespace:Martridge.Models.Configuration"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Martridge.Views.Configuration.SettingsExtensionComponentUserControl">
    
    <Design.DataContext>
        <configuration:SettingsExtensionComponentConfigViewModel />
    </Design.DataContext>
    <UserControl.Styles>
        <StyleInclude Source="avares://martridge/AppStyles.axaml" />
    </UserControl.Styles>
    
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
        <StackPanel Grid.Row="0" Orientation="Vertical">
            <Label Classes="Heading2B"
                   Content="{dloc:Localize SettingsExtensionConfigView/ExePath}" />
            <TextBox Text="{Binding ExePath}" />
        </StackPanel>
        
        <Grid Grid.Row="1" ColumnDefinitions="100,Auto,*">
            <Separator Grid.Column="0" />
            <Label Grid.Column="1" Classes="Heading2B"
                   Content="{dloc:Localize SettingsExtensionConfigView/SteamHeader}" />
            <Separator Grid.Column="2" />
        </Grid>
        
        <StackPanel Grid.Row="2" Orientation="Vertical">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Label Grid.Column="0"
                       Classes="Heading2B"
                       Content="{dloc:Localize SettingsExtensionConfigView/SteamId32}" />
                <Button Grid.Column="2" 
                        Content="{dloc:Localize SettingsExtensionConfigView/AutoDetectSteamId}"
                        Command="{Binding CmdAutoDetectSteamId}" />
            </Grid>
            <TextBox Text="{Binding SteamId32}" />
            
            <CheckBox Classes="Heading2B"
                      Content="{dloc:Localize SettingsExtensionConfigView/PreferLaunchingAsSteamApp}"
                      IsChecked="{Binding PreferLaunchingAsSteamApp}"/>
        </StackPanel>
        
        <Grid Grid.Row="3" ColumnDefinitions="100,Auto,*"
              IsVisible="{x:Static configuration2:Config.PlatformSupportsWine}">
            <Separator Grid.Column="0" />
            <Label Grid.Column="1" Classes="Heading2B"
                   Content="{dloc:Localize SettingsExtensionConfigView/WineHeader}" />
            <Separator Grid.Column="2" />
        </Grid>
            
        
        <StackPanel Grid.Row="4" Orientation="Vertical"
                    IsVisible="{x:Static configuration2:Config.PlatformSupportsWine}">
            
            <Grid RowDefinitions="Auto,*">
                <Label 
                    Grid.Row="0" 
                    Classes="Heading2IWrapping"
                    Content="{dloc:Localize SettingsWineView/DescriptionSpecific}"/>
                <configuration1:SettingsWineUserControl
                    Grid.Row="1"
                    DataContext="{Binding WineViewModel}"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
