<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dloc="using:Martridge.ViewModels.Localization"
             xmlns:vm="using:Martridge.ViewModels.Configuration"

             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             
             x:Class="Martridge.Views.Configuration.SettingsGeneralAdditionalDmodLocationsUserControl"
             
             
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    
    <Design.DataContext>
        <vm:SettingsGeneralViewModel />
    </Design.DataContext>
    <UserControl.Styles>
        <StyleInclude Source="avares://martridge/AppStyles.axaml" />
    </UserControl.Styles>
    
    <Border BorderThickness="1"
            BorderBrush="{DynamicResource ThemeBorderHighBrush}"
            Margin="6,3">
        <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,*,Auto">
            <TextBox Grid.Row="0" Grid.Column="0" 
                     UseFloatingWatermark="True"
                     Watermark="{dloc:Localize SettingsGeneral/AdditionalDmodLocations}"
                     Text="{Binding AdditionalDmodLocationsAddNewManualValue}"/>
            <Button Grid.Row="0" Grid.Column="1"
                    Content="{dloc:Localize SettingsGeneral/AdditionalDmodLocations_AddManual}"
                    Classes="Primary"
                    Command="{Binding CmdAdditionalDmodLocationsAddNewManual}" />
            <Button Grid.Row="0" Grid.Column="2"
                    Content="{dloc:Localize SettingsGeneral/AdditionalDmodLocations_AddBrowse}"
                    Classes="Primary"
                    Command="{Binding CmdAdditionalDmodsAddNew}" />

            <ListBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                     ItemsSource="{Binding AdditionalDmodLocations}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                            <TextBlock Grid.Column="2" Text="{Binding}"></TextBlock>
                            <Button Grid.Column="1"
                                    IsVisible="{Binding $parent[ListBoxItem].IsSelected}"
                                    Command="{Binding $parent[UserControl].DataContext.CmdAdditionalDmodsRemoveSelected}"
                                    CommandParameter="{Binding }" 
                                    Classes="ListBoxButton">
                                <Path Classes="ListBoxIconTrashCan" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
                
        </Grid>
    </Border>
</UserControl>
