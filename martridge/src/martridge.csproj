<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFrameworks>net8.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <!--Avalonia doesen't support TrimMode=link currently,but we are working on that https://github.com/AvaloniaUI/Avalonia/issues/6892 -->
        <TrimMode>copyused</TrimMode>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationIcon>Assets\martridge_new.ico</ApplicationIcon>
        <Version>0.9.0.0</Version>
        <RootNamespace>Martridge</RootNamespace>
        <Configurations>Debug;Release</Configurations>
        <Platforms>AnyCPU;win-x64</Platforms>
        <AvaloniaVersion>11.3.0</AvaloniaVersion>
    </PropertyGroup>

    <PropertyGroup>
        <IsLinux Condition="'$(RuntimeIdentifier)' == 'linux-x64'">true</IsLinux>
        <IsMacOs Condition="'$(RuntimeIdentifier)' == 'osx-x64' or '$(RuntimeIdentifier)' == 'osx-arm64' ">true</IsMacOs>
        <IsWindows Condition="'$(IsLinux)' != 'true' and '$(IsMacOs)' != 'true'">true</IsWindows>
        <IsDinkInstallerEnabled Condition="'$(DisableFeatureDinkInstaller)'!='true'">true</IsDinkInstallerEnabled>
        <IsOnlineFeaturesEnabled Condition="'$(DisableFeatureOnline)'!='true'">true</IsOnlineFeaturesEnabled>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsWindows)'=='true'">
        <DefineConstants>$(DefineConstants);PLATF_WINDOWS</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(IsMacOs)'=='true'">
        <DefineConstants>$(DefineConstants);PLATF_MACOS</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(IsLinux)'=='true'">
        <DefineConstants>$(DefineConstants);PLATF_LINUX</DefineConstants>
    </PropertyGroup>

    <!-- enable dink installer if building for windows, online features are enabled, and dink installer is explicitly enabled -->
    <PropertyGroup Condition="'$(IsWindows)'=='true' And '$(IsOnlineFeaturesEnabled)'=='true' And '$(IsDinkInstallerEnabled)'=='true'">
        <DefineConstants>$(DefineConstants);ENABLE_FEATURE_DINK_INSTALLER</DefineConstants>
    </PropertyGroup>

    <!-- enable online features -->
    <PropertyGroup Condition="'$(IsOnlineFeaturesEnabled)'=='true'">
        <DefineConstants>$(DefineConstants);ENABLE_FEATURE_ONLINE</DefineConstants>
    </PropertyGroup>


    <PropertyGroup>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

        <!-- BaseIntermediateOutputPath is set in Directory.Build.props !! -->
        <!-- <BaseIntermediateOutputPath>..\output.obj\</BaseIntermediateOutputPath> -->
        <IntermediateOutputPath>..\output.obj\$(TargetFramework)_$(Configuration)_$(Platform)\Martridge\</IntermediateOutputPath>
        <OutputPath>..\output\$(TargetFramework)_$(Configuration)_$(Platform)\Martridge\</OutputPath>
        <WarningLevel>4</WarningLevel>
    </PropertyGroup>

    <PropertyGroup>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>


    <ItemGroup>
        <AvaloniaResource Include="Assets\**"/>
        <AvaloniaResource Include="Controls\*.xaml" />
        <AvaloniaXaml Remove="AppStyles.axaml"/>
        <None Remove=".gitignore"/>
        <None Remove="Assets\dloc\en-US.json"/>
        <Folder Include="Assets\graphics"/>
        
        <Content  Include="CustomThemes\*">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="AppStyles.axaml"/>
    </ItemGroup>
    <ItemGroup>
        <!--This helps with theme dll-s trimming.
        If you will publish your application in self-contained mode with p:PublishTrimmed=true and it will use Fluent theme Default theme will be trimmed from the output and vice versa.
        https://github.com/AvaloniaUI/Avalonia/issues/5593 -->
        <TrimmableAssembly Include="Avalonia.Themes.Fluent"/>
        <TrimmableAssembly Include="Avalonia.Themes.Default"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)"/>
        <PackageReference Include="Avalonia.Controls.DataGrid" Version="$(AvaloniaVersion)"/>
        <PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="11.1.5"/>
        <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)"/>
        <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
        <PackageReference Condition="'$(Configuration)' == 'Debug'" 
                          Include="Avalonia.Diagnostics" Version="$(AvaloniaVersion)"/>
        <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="$(AvaloniaVersion)" />
        <PackageReference Include="Avalonia.ReactiveUI" Version="$(AvaloniaVersion)"/>
        <PackageReference Include="GetText.NET" Version="1.9.14"/>
        <!-- only include HtmlAgilityPack if building with online features is enabled! -->
        <PackageReference Condition="'$(IsOnlineFeaturesEnabled)'=='true'" 
                          Include="HtmlAgilityPack" Version="1.11.60"/>
        <PackageReference Include="Ignore" Version="0.2.1" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3"/>
        <PackageReference Include="ReactiveUI.Validation" Version="4.1.1"/>
        <!-- only include SevenZipExtractor if building with dink installer enabled for windows -->
        <PackageReference Condition="'$(IsWindows)'=='true' And '$(IsDinkInstallerEnabled)'=='true' And '$(IsOnlineFeaturesEnabled)'=='true'" 
                          Include="SevenZipExtractor" Version="1.0.17"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\sharpcompress\src\SharpCompress\SharpCompress.csproj"/>
        <ProjectReference Include="..\..\citrus\src\Citrus.Avalonia\Citrus.Avalonia.csproj"/>
        <ProjectReference Include="..\..\citrus\src\Citrus.Avalonia.DataGrid\Citrus.Avalonia.DataGrid.csproj"/>
    </ItemGroup>

    <Target Name="Copy7zipLibs" AfterTargets="Publish" Condition="'$(IsWindows)'=='true'">
        <!-- currently it seems the 7zip libs don't get automagically included in the published single file, so we need to copy them to the published directory-->

        <!-- before, i used to not copy the x64 version because i assumed it was automagically included, but that was not the case, the 7zip wrapper was just defaulting
            to my 7zip install in program files! not good since users might not have 7zip installed at all! -->

        <Copy Condition="'$(Platform)' == 'x86'"
              SourceFiles="$(ProjectDir)\lib\7zip\x86\7z.dll"
              DestinationFiles="$(PublishDir)\x86\7z.dll"/>

        <Copy Condition="'$(Platform)' == 'x64'"
              SourceFiles="$(ProjectDir)\lib\7zip\x64\7z.dll"
              DestinationFiles="$(PublishDir)\x64\7z.dll"/>

        <!-- copy license file too.. i think i was supposed to do this before as well but didn't notice?... oops! -->
        <Copy SourceFiles="$(ProjectDir)\lib\7zip\7ZipLicense.txt" DestinationFiles="$(PublishDir)\7ZipLicense.txt"/>
    </Target>

    <!-- remove online features related code if they are not enabled -->
    <ItemGroup Condition="'$(IsOnlineFeaturesEnabled)'!='true'">
        <Compile Remove="Models\DinkInstaller\*"/>
        <Compile Remove="Models\OnlineDmods\*"/>
        <Compile Remove="ViewModels\DinkInstaller\*"/>
        <Compile Remove="ViewModels\OnlineDmod\*"/>
        <Compile Remove="ViewModels\Dmod\DualDmodBrowserViewModel.cs"/>
        <Compile Remove="Views\DinkInstaller\*"/>
        <Compile Remove="Views\OnlineDmod\*"/>
        <Compile Remove="Views\Dmod\DualDmodBrowserView.axaml.cs"/>
        <AvaloniaXaml Remove="Views\DinkInstaller\*"/>
        <AvaloniaXaml Remove="Views\OnlineDmod\*"/>
        <AvaloniaXaml Remove="Views\Dmod\DualDmodBrowserView.axaml"/>
    </ItemGroup>

    <!-- remove DinkInstaller stuff if it is not enabled or we are not building for Windows -->
    <ItemGroup Condition="'$(IsDinkInstallerEnabled)'!='true' Or '$(IsWindows)'!='true'">
        <Compile Remove="Models\DinkInstaller\*"/>
        <Compile Remove="ViewModels\DinkInstaller\*"/>
        <Compile Remove="Views\DinkInstaller\*"/>
        <AvaloniaXaml Remove="Views\DinkInstaller\*"/>
    </ItemGroup>
</Project>
