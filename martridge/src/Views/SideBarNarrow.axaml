    </UserControl.Resources>
    
    <Grid RowDefinitions="*,Auto" Background="{DynamicResource ThemeAccentBrush2}">
                    <Grid.Styles>
                        <Style Selector="controls|SelectableButton">
                            <Setter Property="Width" Value="40" />
                        </Style>
                    </Grid.Styles>

                    <WrapPanel Grid.Row="0"
                               Orientation="Vertical">
                        <controls:SelectableButton
                            IsSelected="{Binding CurrentViewModel,
                            Converter={StaticResource TypeCompareToBoolConverter},
                            ConverterParameter={}AboutViewModel,
                            Mode=OneWay}"
                            Command="{Binding CmdShowPageAbout}">
                            <Path Classes="SideBarIcon"
                                  Data="{DynamicResource SideIcon1About}"/>
                        </controls:SelectableButton>
                        <controls:SelectableButton
                            Command="{Binding CmdShowPageMyDmods}"
                            IsSelected="{Binding CurrentViewModel,
                            Converter={StaticResource TypeCompareToBoolConverter},
                            ConverterParameter={}DmodBrowserViewModel,
                            Mode=OneWay}">
                            <Path Classes="SideBarIcon"
                                  Data="{DynamicResource SideIcon2Dmods}"/>
                        </controls:SelectableButton>
                        <controls:SelectableButton
                            Command="{Binding CmdShowPageOnlineDmods}"
                            IsVisible="{Binding EnableOnlineFeatures}"
                            IsSelected="{Binding CurrentViewModel,
                            Converter={StaticResource TypeCompareToBoolConverter},
                            ConverterParameter={}OnlineDmodBrowserViewModel,
                            Mode=OneWay}" >
                            <Path Classes="SideBarIcon"
                                  Data="{DynamicResource SideIcon2OnlineDmods}"/>
                        </controls:SelectableButton>
                        <controls:SelectableButton
                            IsSelected="{Binding CurrentViewModel,
                            Converter={StaticResource TypeCompareToBoolConverter},
                            ConverterParameter={}SettingsGeneralViewModel,
                            Mode=OneWay}" 
                            Command="{Binding CmdShowPageSettings}" >
                            <Path Classes="SideBarIcon"
                                  Data="{DynamicResource SideIcon3Settings}"/>
                        </controls:SelectableButton>
                        <controls:SelectableButton
                            IsSelected="{Binding CurrentViewModel,
                            Converter={StaticResource TypeCompareToBoolConverter},
                            ConverterParameter={}SettingsThemeViewModel,
                            Mode=OneWay}"
                            Command="{Binding CmdShowPageSettingsTheme}" >
                            <Path Classes="SideBarIcon"
                                  Data="{DynamicResource SideIcon4Theme}"/>
                        </controls:SelectableButton>
                        <controls:SelectableButton
                            Command="{Binding CmdShowPageDmodInstallerAndBrowse}"
                            IsSelected="{Binding CurrentViewModel,
                            Converter={StaticResource TypeCompareToBoolConverter},
                            ConverterParameter={}DmodInstallerViewModel,
                            Mode=OneWay}" >
                            <Path Classes="SideBarIcon"
                                  Data="{DynamicResource SideIcon5UnpackDmod}"/>
                        </controls:SelectableButton>
                        <controls:SelectableButton
                            Command="{Binding CmdShowPageDmodPackerAndBrowse}"
                            IsSelected="{Binding CurrentViewModel,
                            Converter={StaticResource TypeCompareToBoolConverter},
                            ConverterParameter={}DmodPackerViewModel,
                            Mode=OneWay}"
                            IsVisible="{Binding EnableDmodDeveloperFeatures}"
                            IsEnabled="{Binding EnableDmodDeveloperFeatures}" >
                            <Path Classes="SideBarIcon"
                                  Data="{DynamicResource SideIcon6PackDmod}"/>
                        </controls:SelectableButton>

                        <controls:SelectableButton
                            Command="{Binding CmdShowPageDinkInstaller}"
                            IsSelected="{Binding CurrentViewModel,
                            Converter={StaticResource TypeCompareToBoolConverter},
                            ConverterParameter={}DinkInstallerViewModel,
                            Mode=OneWay}"
                            IsVisible="{Binding EnableDinkInstallerMenu}"
                            IsEnabled="{Binding EnableDinkInstallerMenu}" >
                            <Path Classes="SideBarIcon"
                                  Data="{DynamicResource SideIcon7InstallDink}"/>
                        </controls:SelectableButton>
                    </WrapPanel>
                </Grid>
    
    
</UserControl>
