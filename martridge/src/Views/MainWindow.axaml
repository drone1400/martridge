<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Martridge.ViewModels"
        xmlns:martridge="clr-namespace:Martridge"
        xmlns:valueConverters="clr-namespace:Martridge.ViewModels.ValueConverters"
        xmlns:dinkyAlerts="clr-namespace:Martridge.Views.DinkyAlerts"
        xmlns:views="clr-namespace:Martridge.Views"
        xmlns:system="clr-namespace:System;assembly=System.Runtime"

        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"

        MinWidth="600"
        MinHeight="480"

        x:Class="Martridge.Views.MainWindow"

        Icon="/Assets/martridge_new.ico"
        Title="{Binding Title}"
        Background="{DynamicResource ThemeBackgroundBrush}"
        Name="TheMainWindow"

        KeyDown="InputElement_OnKeyDown"
        XYFocus.NavigationModes="Enabled">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>
    <Window.Styles>
        <StyleInclude Source="avares://martridge/AppStyles.axaml" />
    </Window.Styles>
    <Window.Resources>
        <valueConverters:DoubleCompareBoolConverter x:Key="DoubleCompareBoolConverter" />
        <valueConverters:IsNullCheckBoolConverter x:Key="IsNullCheckBoolConverter" />
        <valueConverters:IsNotNullCheckBoolConverter x:Key="IsNotNullCheckBoolConverter" />
        <system:Double x:Key="MinimumWindowWidthThreshold">750</system:Double>
    </Window.Resources>

    <Border
        Margin="0"
        Padding="0"
        Background="Transparent"
        BorderBrush="Transparent"
        BorderThickness="0"
        CornerRadius="0">

        <Grid>
            
            <!-- main content is only enabled if there is no active alert... -->
            <Grid ColumnDefinitions="Auto,*"
                  IsEnabled="{Binding AlertViewModel,
                        Converter={StaticResource IsNullCheckBoolConverter}}"
                  DragDrop.AllowDrop="True"
                  x:Name="gridMainContent">
                
                <ContentPresenter Grid.Column="0"
                    Content="{Binding Bounds.Width, ElementName=gridMainContent, 
                            Converter={StaticResource DoubleCompareBoolConverter},
                            ConverterParameter={StaticResource MinimumWindowWidthThreshold}}">
                    <ContentPresenter.ContentTemplate>
                        <martridge:GenericTemplateSelector>
                            <DataTemplate x:Key="true">
                                <Grid DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=views:MainWindow}}">
                                    <views:SideBarWide />
                                </Grid>
                            </DataTemplate>
                            <DataTemplate x:Key="false">
                                <Grid DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=views:MainWindow}}">
                                    <views:SideBarNarrow />
                                </Grid>
                            </DataTemplate>
                        </martridge:GenericTemplateSelector>
                    </ContentPresenter.ContentTemplate>
                </ContentPresenter>

                <Grid Grid.Column="1">
                    <ContentControl Content="{Binding CurrentViewModel}">
                        <ContentControl.DataTemplates>
                            <martridge:MainViewLocator />
                        </ContentControl.DataTemplates>
                    </ContentControl>
                </Grid>
            </Grid>
            
            <Grid
                IsEnabled="{Binding AlertViewModel,
                    Converter={StaticResource IsNotNullCheckBoolConverter}}"
                IsVisible="{Binding AlertViewModel,
                    Converter={StaticResource IsNotNullCheckBoolConverter}}"
                ZIndex="999">
                <dinkyAlerts:DinkyAlertView 
                    DataContext="{Binding AlertViewModel}"/>
            </Grid>

        </Grid>
    </Border>
</Window>